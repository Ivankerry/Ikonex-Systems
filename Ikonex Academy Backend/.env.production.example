# =========================================================================
# Ikonex Academy — Production Environment Variables Configuration Template
# Copy this file to '.env' on the VPS and fill in the values.
# =========================================================================

# Database Configuration
# These are used by Docker Compose to initialize the Postgres container and build the Node connection string
DB_USER=postgres
DB_PASSWORD=replace_with_a_secure_random_alphanumeric_password_here
DB_NAME=ikonex_academy

# Frontend CORS Origin Configuration
# Specify the exact URL of your frontend application hosted on Vercel.
# For security, do NOT use '*' in production.
CORS_ORIGIN=https://ikonex-academy-frontend.vercel.app
